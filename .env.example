# 复制为 .env 并按环境填写。密钥行绝不提交到 Git。

# ── 环境标识 ──────────────────────────────────────────────────────────────────
# development | production
RAG_ENVIRONMENT=development
# 生产环境公网地址（用于 CSRF Origin 校验和日志）
PUBLIC_BASE_URL=http://127.0.0.1:8000

# ── 鉴权模式 ──────────────────────────────────────────────────────────────────
# 单用户: DEPLOYMENT_MODE=single_user  AUTH_MODE=legacy  APP_PASSWORD=<密码>
# 多用户: DEPLOYMENT_MODE=multi_user   AUTH_MODE=users   AUTH_SECRET=<32字节随机串>
DEPLOYMENT_MODE=dev
AUTH_MODE=legacy
APP_PASSWORD=
AUTH_SECRET=
AUTH_DB_PATH=./data/auth.sqlite3
AUTH_TOKEN_TTL_SECONDS=28800
AUTH_COOKIE_NAME=rag_access
# 生产环境必须为 1（需同时启用 HTTPS）
AUTH_COOKIE_SECURE=0

# ── 质量反馈（可选，需保管加密密钥）────────────────────────────────────────────
QUALITY_CAPTURE_ENABLED=0
QUALITY_DB_PATH=./data/quality.sqlite3
QUALITY_ENCRYPTION_KEY=
QUALITY_RETENTION_DAYS=30
QUALITY_MAX_QUERY_CHARS=4000
QUALITY_MAX_ANSWER_CHARS=12000
QUALITY_FEEDBACK_LIMIT_PER_HOUR=30

# ── 指标采集 ──────────────────────────────────────────────────────────────────
# 不设则仅允许 loopback 访问 /metrics
METRICS_TOKEN=

# ── LLM 接入 ──────────────────────────────────────────────────────────────────
# DeepSeek
DEEPSEEK_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash
# DashScope (阿里云)
# DASHSCOPE_API_KEY=
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_MODEL=<当前账号可用的模型ID>
# 其他 OpenAI 兼容端点使用 OPENAI_API_KEY
# OPENAI_API_KEY=

# 流式 usage：auto 仅对 DashScope 开启；其他兼容端点按实际支持设 on/off
LLM_STREAM_USAGE_MODE=auto
LLM_PRICE_TABLE_PATH=./config/llm_prices.json

# ── 本地检索模型 ──────────────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# 离线部署先准备模型，再设为 1
HF_HUB_OFFLINE=0

# ── 告警通知 ──────────────────────────────────────────────────────────────────
# 企业微信机器人 Webhook URL，生产环境必填（production_security_error 会检查）
ALERT_WEBHOOK_URL=

# ── 监控栈（docker compose --profile monitoring up -d）────────────────────────
# Prometheus 用上面那个 METRICS_TOKEN 做 Bearer 认证抓取 /metrics，此处不再重复声明：
# 同名键在 .env 中出现两次时后者覆盖前者，很容易把已填好的 token 清空。
#
# Grafana 管理员密码。无默认值，且不接受 changeme/admin/password；
# 与 METRICS_TOKEN、ALERT_WEBHOOK_URL 任一为空时，monitoring profile 会被
# monitoring-preflight 拒绝启动（宁可起不来，也不要监控假装在跑）。
GRAFANA_ADMIN_PASSWORD=

# ── 数据目录（Docker 部署时由 compose 卷覆盖，无需修改）────────────────────────
RAG_DATA_DIR=./data
RAG_LOG_DIR=./data/logs
RAG_BACKUP_DIR=./backups
# 文档治理唯一配置；不应指向未经审核的临时文件
RAG_DOCUMENT_GOVERNANCE_PATH=./config/document_governance.json

# ── 回答缓存、检索版本和已有功能开关 ─────────────────────────────────────────
ANSWER_CACHE_ENABLED=1
ANSWER_CACHE_TTL_SECONDS=86400
CACHE_SALT=
PROMPT_VERSION=grounded-v3
RETRIEVAL_VERSION=hybrid-rerank-v2
# 默认与 OPENAI_MODEL 相同；模型行为变化时可显式设置
MODEL_VERSION=deepseek-v4-flash
DRAFT_ENABLED=1
FALLBACK_ENABLED=1

# ── 上传与批处理 ──────────────────────────────────────────────────────────────
UPLOAD_TASK_WORKERS=1
UPLOAD_PARSE_WORKERS=2
UPLOAD_QUEUE_CAPACITY=4
UPLOAD_MAX_BATCH_MB=200
UPLOAD_STAGING_TTL_SECONDS=86400
VECTOR_WRITE_BATCH_SIZE=512
EMBEDDING_BATCH_SIZE=32
RERANK_BATCH_SIZE=16
RERANK_SCORE_THRESHOLD=0.5

# ── 日志 ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=7
LOG_RETENTION_DAYS=30
ACCESS_LOG_RETENTION_DAYS=7
AUDIT_LOG_RETENTION_DAYS=90

# ── 健康检查阈值 ──────────────────────────────────────────────────────────────
RAG_READY_URL=http://127.0.0.1:8000/api/ready
# 可选覆盖；默认位于 RAG_LOG_DIR
# RAG_ALERT_STATE=./data/logs/alerts_state.json
# RAG_ALERT_LOG=./data/logs/alerts.log
HEALTH_BACKUP_MAX_AGE_DAYS=7
HEALTH_MIN_FREE_GB=1
HEALTH_ERROR_RATE_THRESHOLD=0.05
HEALTH_ERROR_MIN_REQUESTS=10
HEALTH_AUTH_FAILURE_MIN=2
HEALTH_SLOW_REQUEST_MS=60000
HEALTH_SLOW_LLM_MS=30000
HEALTH_SLOW_MIN_COUNT=3
