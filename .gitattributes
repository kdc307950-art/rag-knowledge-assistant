# 统一换行符为 LF，防止 Windows 工具（VS Code / Claude Code 等）把文件 CRLF 化后污染 diff
* text=auto
*.py text eol=lf
*.pyi text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
