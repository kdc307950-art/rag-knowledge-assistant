{
  "title": "RAG 系统总览",
  "uid": "rag-overview-v1",
  "version": 1,
  "schemaVersion": 39,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "tags": ["rag"],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "服务状态",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "targets": [{ "expr": "up{job=\"rag\"}", "legendFormat": "backend" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "向量存储健康",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "type": "value", "options": { "0": { "text": "不健康", "color": "red" }, "1": { "text": "健康", "color": "green" } } }],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "targets": [{ "expr": "rag_vector_health", "legendFormat": "vector" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "文档数 / Chunk 数",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "options": { "colorMode": "none", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] }, "text": {} },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } } },
      "targets": [
        { "expr": "rag_docs_count", "legendFormat": "文档" },
        { "expr": "rag_chunks_count", "legendFormat": "Chunk" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "活跃 SSE 连接",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "options": { "colorMode": "none", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } } },
      "targets": [{ "expr": "sum(rag_sse_active_connections)", "legendFormat": "SSE" }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "请求速率 (req/s)",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 2 } } },
      "targets": [
        { "expr": "sum(rate(rag_requests_total{route_type=\"request\"}[2m])) by (route)", "legendFormat": "{{route}}" },
        { "expr": "sum(rate(rag_requests_total{route_type=\"sse\"}[2m]))", "legendFormat": "SSE (chat)" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "错误率",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": { "lineWidth": 2 },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.02 }, { "color": "red", "value": 0.05 }] }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(rag_errors_total[5m])) / (sum(rate(rag_requests_total{route_type=\"request\"}[5m])) + 0.001)",
          "legendFormat": "错误率"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "LLM 延迟分位数",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "lineWidth": 2 } } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(rag_llm_latency_seconds_bucket[10m])) by (le))", "legendFormat": "P50" },
        { "expr": "histogram_quantile(0.95, sum(rate(rag_llm_latency_seconds_bucket[10m])) by (le))", "legendFormat": "P95" },
        { "expr": "histogram_quantile(0.99, sum(rate(rag_llm_latency_seconds_bucket[10m])) by (le))", "legendFormat": "P99" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "认证失败速率",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "custom": { "lineWidth": 2 },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.5 }] }
        }
      },
      "targets": [{ "expr": "sum(rate(rag_auth_failures_total[5m])) by (route)", "legendFormat": "{{route}}" }]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "LLM Token 用量",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2 } } },
      "targets": [
        { "expr": "sum(rate(rag_llm_tokens_total{type=\"input\"}[10m])) by (mode)", "legendFormat": "输入 {{mode}}" },
        { "expr": "sum(rate(rag_llm_tokens_total{type=\"output\"}[10m])) by (mode)", "legendFormat": "输出 {{mode}}" }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "知识库操作",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "cps", "custom": { "lineWidth": 2 } } },
      "targets": [
        { "expr": "sum(rate(rag_retrievals_total[5m])) by (outcome)", "legendFormat": "检索 {{outcome}}" },
        { "expr": "rate(rag_refusals_total[5m])", "legendFormat": "拒答" },
        { "expr": "sum(rate(rag_upload_tasks_total[5m])) by (result)", "legendFormat": "上传 {{result}}" }
      ]
    }
  ]
}
